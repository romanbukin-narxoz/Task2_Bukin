{
  "mode": "smoke",
  "data_path": "data/sample/emails.csv",
  "output_dir": "results/smoke",
  "test_size": 0.4,
  "split_seed": 42,
  "seeds": [
    42
  ],
  "train_fractions": [
    1.0
  ],
  "max_fpr": 0.05,
  "tfidf": {
    "lowercase": true,
    "ngram_range": [
      1,
      1
    ],
    "max_features": 5000,
    "min_df": 1
  },
  "models": {
    "naive_bayes": {
      "alpha": 1.0
    },
    "logistic_regression": {
      "C": 1.0,
      "solver": "liblinear",
      "max_iter": 1000
    },
    "random_forest": {
      "n_estimators": 100,
      "max_depth": null
    }
  }
}
